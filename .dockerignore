# The image copies the checkout as git tracks it: local environments, builds, caches, runs,
# locally built circuits, credentials and editor settings stay out (as in .gitignore).
.git
.github
.devcontainer
**/.venv
**/venv
**/node_modules
frontend/dist
.cache
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/*.egg-info
*.log

runs/*
!runs/.gitkeep
data/*
!data/README.md
!data/atlas
!data/examples
!data/circuits
!data/recordings
data/recordings/*
!data/recordings/downloads.json
!data/recordings/LICENSE.md
data/circuits/local
configs/local
docs/evidence/*
!docs/evidence/README.md

.env
.env.*
**/.DS_Store
**/.codex
**/.claude
**/.agents
**/.idea
**/.vscode
**/.npmrc
**/.pypirc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
