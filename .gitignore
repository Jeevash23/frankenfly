# Local environments and generated builds
backend/.venv/
.venv/
venv/
node_modules/
frontend/dist/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Personal settings, credentials and OS/editor files
.DS_Store
.env
.env.*
!.env.example
# No leading slash, so these also match inside frontend/ and backend/.
.codex/
.claude/
.agents/
.idea/
.vscode/
.npmrc
.pypirc
*.key
*.pem
*.p12
*.pfx

# Local experiment records, imports and downloaded caches
/runs/*
!/runs/.gitkeep
/data/*
!/data/README.md
!/data/atlas/
!/data/examples/
!/data/circuits/
!/data/recordings/
# Raw recordings belong in .cache/recordings/; only their manifest and license are tracked.
/data/recordings/*
!/data/recordings/downloads.json
!/data/recordings/LICENSE.md
# Circuits built locally from the app or the builder's `build` command stay on this machine.
/data/circuits/local/
# So do presets saved from the app.
/configs/local/

# Execution evidence can contain local paths, device details and session IDs.
# Only the generic instructions belong in the public repository.
/docs/evidence/*
!/docs/evidence/README.md
*.log
